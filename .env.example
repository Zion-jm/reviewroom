# Local development uses SQLite automatically. Production REQUIRES PostgreSQL.
PORT=3000
NODE_ENV=development
# Aiven PostgreSQL service URI. Never commit real credentials.
DATABASE_URL=
# Paste the Aiven CA certificate as a single line, replacing line breaks with \n.
DATABASE_CA_CERT=
# Set a unique password of at least 16 characters to enable the admin area.
ADMIN_PASSWORD=
# Exact public URL, without a trailing slash. Required in production.
APP_ORIGIN=http://localhost:3000
